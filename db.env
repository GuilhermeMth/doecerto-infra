# ==============================================================================
# MYSQL DATABASE CONFIGURATION (DISTRIBUIÇÃO)
# ==============================================================================
# O Docker oficial do MySQL usa essas variáveis para o setup inicial
MYSQL_ROOT_PASSWORD=${DB_PASSWORD}
MYSQL_DATABASE=${DB_NAME}

# Opcional: Criar um usuário que não seja o root (Melhor prática de segurança)
# MYSQL_USER=${DB_USER}
# MYSQL_PASSWORD=${DB_PASSWORD}