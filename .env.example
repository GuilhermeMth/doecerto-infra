# ==============================================================================
# INFRAESTRUTURA E REDE (DINÂMICO)
# ==============================================================================
# O MY_DOMAIN e VM_IP são injetados automaticamente pelo seu Workflow do GitHub
# BACKEND_URL deve apontar para o domínio com /api
BACKEND_URL=https://doecerto.eastus2.cloudapp.azure.com/api
FRONTEND_URL=https://doecerto.eastus2.cloudapp.azure.com

# ==============================================================================
# BANCO DE DADOS (MYSQL)
# ==============================================================================
# Importante: O Docker oficial do MySQL usa MYSQL_ROOT_PASSWORD
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha123
DB_NAME=doecerto

MYSQL_ROOT_PASSWORD=senha123
MYSQL_DATABASE=doecerto

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================================================================
# SEGURANÇA (JWT)
# ==============================================================================
# Use um hash longo e único
JWT_SECRET=3b8e2f9c5a7d4e8f1a2c6b9d0f4a1e3c
JWT_ALGORITHM=HS256

# ==============================================================================
# APLICAÇÃO E SEED
# ==============================================================================
# Porta interna que o NestJS vai rodar (Deve bater com o Caddyfile)
PORT=3501
NODE_ENV=production
RUN_SEED=true

# ==============================================================================
# E-MAIL (SMTP) - Opcional
# ==============================================================================
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_USER=usuario@exemplo.com
EMAIL_PASS=5f4dcc3b5aa765d61d8327deb882cf99
EMAIL_FROM=noreply@doecerto.com