doecerto.eastus2.cloudapp.azure.com {

    # 1. API - Usando 'handle' em vez de 'handle_path' se o seu front já manda o /api
    # Ou mantendo handle_path se você quer que a API ignore o prefixo.
    handle_path /api/* {
        reverse_proxy doecerto_api:3501
    }

    # 2. FRONTEND
    handle {
        reverse_proxy doecerto_frontend:3535
    }

    # --- Configurações Adicionais ---
    encode zstd gzip
    
    # ISSO AQUI VAI TE SALVAR: 
    # Força o Caddy a não tentar servir arquivos estáticos do front se a rota for /api
    @api {
        path /api/*
    }
}