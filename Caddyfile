doecerto.eastus2.cloudapp.azure.com {
    # 1. API
    # O handle_path remove o "/api" e manda o resto para o container
    handle_path /api/* {
        reverse_proxy doecerto_api:3501
    }

    # 2. FRONTEND
    # O handle sem path pega tudo que não entrou no handle_path acima
    handle {
        reverse_proxy doecerto_frontend:3535
    }

    # Compressão para performance
    encode zstd gzip

    # Logs para debug (Verifique /data/access.log se der erro)
    log {
        output file /data/access.log
    }

    # Headers de segurança básicos
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000;"
    }
}